{
  "name": "behavior-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter '@eddy/*' --parallel build",
    "test": "pnpm --filter '@eddy/*' --parallel test",
    "lint": "pnpm --filter '@eddy/*' --parallel lint",
    "dev": "pnpm --filter '@eddy/behavior-next' dev",
    "clean": "pnpm run -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@eslint/eslintrc": "^3.2.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@8.0.0"
}
